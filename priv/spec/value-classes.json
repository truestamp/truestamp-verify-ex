    "CHECKED": "recomputed and compared",
    "PATH INPUT": "bound by the walk",
    "PINNED": "compared with pinned values before anything uses them",
    "PREIMAGE": "input to a CHECKED hash or a named check; a payload value is compared with its source only after a read",
    "RECORDED": "never a verdict input except where a row above uses it; shown under a provenance heading chosen by attribution",
    "SUBMITTED": "bound by claims_hash; shown only as the submitter's statement, with bidirectional and zero-width characters escaped"
  },
